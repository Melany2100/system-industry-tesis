# ============================================================
# SMRI - .env para la maquina local del jefe
# Procesa las camaras localmente, publica el video hacia MediaMTX y replica los
# eventos mediante HTTPS. La base local sigue siendo la fuente durable del edge.
# ============================================================

# ------------------------------------------------------------
# Django local
# ------------------------------------------------------------
SECRET_KEY=cambiar_por_una_clave_larga_y_segura
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,192.168.10.10
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://192.168.10.10:8000
SMRI_NODE_ROLE=edge

# Publicación no bloqueante del video procesado hacia MediaMTX.
# La contraseña debe escribirse con codificación URL si contiene @, : o /.
MEDIAMTX_PUBLISH_BASE_URL=rtsp://publisher:CAMBIAR_PASSWORD@IP_PUBLICA_VPS:8554
FFMPEG_BINARY=ffmpeg

# Debe terminar en /camera/api/v1/events/ y usar HTTPS.
SMRI_EVENT_SYNC_URL=https://app.midominio.com/camera/api/v1/events/
SMRI_EVENT_SYNC_TOKEN=CAMBIAR_TOKEN_ALEATORIO_DE_64_CARACTERES
SMRI_EDGE_NODE_ID=planta-principal
SMRI_EVENT_SYNC_INTERVAL_SECONDS=3
SMRI_EVENT_SYNC_TIMEOUT_SECONDS=15
SMRI_EVENT_SYNC_BATCH_SIZE=10

# ------------------------------------------------------------
# Base de datos LOCAL. No apuntar este nodo a PostgreSQL de DigitalOcean.
# No se debe abrir el puerto 5432 de la VPS: la sincronización usa HTTPS 443.
# ------------------------------------------------------------
DB_NAME=smri_local
DB_USER=smri_local_user
DB_PASSWORD=CAMBIAR_PASSWORD_POSTGRES_LOCAL
DB_HOST=127.0.0.1
DB_PORT=5432

# ------------------------------------------------------------
# Correo de incidentes
# Si la maquina local crea el evento, tambien intentara enviar
# el correo segun el backend configurado.
# ------------------------------------------------------------
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=cuenta.smtp@example.com
EMAIL_HOST_PASSWORD=clave_o_token_de_aplicacion
DEFAULT_FROM_EMAIL=Sistema SMRI <cuenta.smtp@example.com>
EMAIL_TIMEOUT=10

# ------------------------------------------------------------
# Camaras VIGI C240 en la red local del switch
# Registrar estas mismas URLs en el admin de Django, modelo Camera.
# Recomendado usar stream2 para deteccion por menor carga.
# ------------------------------------------------------------
RTSP_CAMERA_1_URL=rtsp://admin:CAMBIAR_PASSWORD_CAMARA@192.168.10.201:554/stream2
RTSP_CAMERA_2_URL=rtsp://admin:CAMBIAR_PASSWORD_CAMARA@192.168.10.202:554/stream2

# Una URL stream2 se usa como flujo unico para no decodificar simultaneamente
# los perfiles 1440p y 1080p. Cambiar a True solo si el equipo tiene GPU/CPU
# suficiente y se necesita stream1 para obtener evidencia con mayor detalle.
RTSP_DUAL_STREAM_ENABLED=True
RTSP_FORCE_MAIN_ANALYSIS_FROM_SUBSTREAM=False
RTSP_SKIP_MAIN_WHEN_PREVIEW_WIDTH_AT_LEAST=1280
RTSP_OPEN_TIMEOUT_MILLISECONDS=5000
RTSP_READ_TIMEOUT_MILLISECONDS=3000
RTSP_RECONNECT_DELAY_SECONDS=2

# Variables legacy usadas por pruebas directas del proyecto.
RTSP_CAMERA_URL=rtsp://admin:CAMBIAR_PASSWORD_CAMARA@192.168.10.201:554/stream1
RTSP_CAMERA_URL_FAST=rtsp://admin:CAMBIAR_PASSWORD_CAMARA@192.168.10.201:554/stream2

# ------------------------------------------------------------
# Autoinicio local de camaras
# start_smri.bat ya establece estas variables, pero se dejan aqui
# como referencia si se inicia Django manualmente.
# ------------------------------------------------------------
SMRI_AUTOSTART_CAMERAS=1
SMRI_CAMERA_AUTOSTART_FPS=8
PPE_CONFIRMATION_FRAMES=3
PPE_MODEL_CONFIDENCE=0.10
PPE_GLOVES_CONFIDENCE=0.12
PPE_EARMUFFS_CONFIDENCE=0.10
PPE_PRESENCE_TTL_SECONDS=8

# OpenCV 5 puede advertir que DSHOW no admite captura por indice.
LOCAL_CAMERA_BACKENDS=MSMF,DEFAULT
LOCAL_CAMERA_CAPTURE_WIDTH=640
LOCAL_CAMERA_CAPTURE_HEIGHT=480

# Objetos cortopunzantes: evita falsos positivos de guantes/manos.
SHARP_OBJECT_CONF=0.20
SHARP_SCISSORS_ALERT_CONF=0.30
SHARP_PERSON_CROP_ENABLED=True
RISK_BOTTLE_ALERT_CONF=0.20
RISK_PERSON_CROP_ENABLED=True
PPE_IDENTITY_TRACKING_TTL_SECONDS=30
FACE_DB_SYNC_SECONDS=2
SHARP_KNIFE_ALERT_CONF=0.45
SHARP_SCISSORS_ALERT_CONF=0.50
SHARP_OBJECT_CONFIRMATION_FRAMES=3
