# ============================================================
# SMRI - .env para la maquina local del jefe
# Objetivo: procesar las camaras locales y registrar eventos
# en la base de datos PostgreSQL que vive en la VPS.
# ============================================================

# ------------------------------------------------------------
# Django local
# ------------------------------------------------------------
DJANGO_SECRET_KEY=cambiar_por_una_clave_larga_y_segura
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,192.168.10.10
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://192.168.10.10:8000

# ------------------------------------------------------------
# Conexion a la base de datos de la VPS
# OPCION RECOMENDADA: tunel SSH local.
#
# Antes de iniciar el sistema local, abrir el tunel:
# ssh -N -L 15432:127.0.0.1:5432 usuario_vps@IP_PUBLICA_VPS
#
# Con esto, Django se conecta a 127.0.0.1:15432, pero en realidad
# escribe en PostgreSQL de la VPS.
# ------------------------------------------------------------
DB_NAME=smri_prod
DB_USER=smri_user
DB_PASSWORD=CAMBIAR_PASSWORD_POSTGRES_VPS
DB_HOST=127.0.0.1
DB_PORT=15432

# ------------------------------------------------------------
# OPCION ALTERNATIVA NO RECOMENDADA:
# conexion directa a PostgreSQL de la VPS.
#
# Usar solo si la VPS permite el puerto 5432 exclusivamente desde
# la IP publica de la empresa mediante firewall.
#
# DB_HOST=IP_PUBLICA_VPS
# DB_PORT=5432
# ------------------------------------------------------------

# ------------------------------------------------------------
# Correo de incidentes
# Si la maquina local crea el evento, tambien intentara enviar
# el correo segun el backend configurado.
# ------------------------------------------------------------
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=cuenta.smtp@example.com
EMAIL_HOST_PASSWORD=clave_o_token_de_aplicacion
DEFAULT_FROM_EMAIL=Sistema SMRI <cuenta.smtp@example.com>
EMAIL_TIMEOUT=10

# ------------------------------------------------------------
# Camaras VIGI C240 en la red local del switch
# Registrar estas mismas URLs en el admin de Django, modelo Camera.
# Recomendado usar stream2 para deteccion por menor carga.
# ------------------------------------------------------------
RTSP_CAMERA_1_URL=rtsp://admin:CAMBIAR_PASSWORD_CAMARA@192.168.10.201:554/stream2
RTSP_CAMERA_2_URL=rtsp://admin:CAMBIAR_PASSWORD_CAMARA@192.168.10.202:554/stream2

# Variables legacy usadas por pruebas directas del proyecto.
RTSP_CAMERA_URL=rtsp://admin:CAMBIAR_PASSWORD_CAMARA@192.168.10.201:554/stream1
RTSP_CAMERA_URL_FAST=rtsp://admin:CAMBIAR_PASSWORD_CAMARA@192.168.10.201:554/stream2

# ------------------------------------------------------------
# Autoinicio local de camaras
# start_smri.bat ya establece estas variables, pero se dejan aqui
# como referencia si se inicia Django manualmente.
# ------------------------------------------------------------
SMRI_AUTOSTART_CAMERAS=1
SMRI_CAMERA_AUTOSTART_FPS=8
